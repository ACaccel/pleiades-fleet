/node_modules
/dist
/logs
/data
*.log

# Personal Claude Code settings (machine-specific allowlists, paths).
# Shared agent instructions live in AGENTS.md.
.claude/settings.json
.claude/settings.local.json
.claude/scheduled_tasks.lock

.env
config.json
guild_profile.json
avatar_url_list.txt
remove_list.txt
snippet.ts
debug.sh
/coverage

# Internal design / proposal working documents are kept local, not
# version-controlled (the v1.0.0 cleanup removed the tracked ones).
docs/proposal.md
.plan/

# Ops tools — operator-supplied configs and per-run log output.
# `config.json` is already matched by the global rule above; the
# explicit entries below keep the tool-specific layout self-documenting.
# Archive exports from the removed `tools/db` CLI may remain on operator hosts.
tools/db/backups/
tools/migration/config.*.json
!tools/migration/config.example.json
tools/migration/*.local.*
tools/migration/runs/
tools/migration/.state/
tools/migration/backups/
tools/migration/dump/
tools/migration/*.tar.gz
tools/migration/*.archive.gz

# Project runtime and operator-owned deployment state.
/.conda/
/.deploy/
/deployment.json
/.runtime/
/.conda-fonts/

# Complete state copies retained by offline cutover recovery.
/data.pre-cutover-*/
/logs.pre-cutover-*/
